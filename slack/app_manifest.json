{
  "display_information": {
    "name": "Gold",
    "description": "Matches candidate threads to live Paraform roles. Tag \"@Gold gold\" in a candidate thread.",
    "background_color": "#1B1F2A"
  },
  "features": {
    "bot_user": {
      "display_name": "Gold",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "files:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
