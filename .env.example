# Slack (create app at https://api.slack.com/apps, enable Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...           # Socket Mode app-level token with connections:write
CANDIDATES_CHANNEL_ID=C0123456789  # optional: only respond in this channel

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high                  # low | medium | high | xhigh | max

# Paraform (no public API -- an authenticated browser session is used)
PARAFORM_BROWSE_URL=https://www.paraform.com/browse
PARAFORM_STORAGE_STATE=./paraform_state.json   # written by scripts/paraform_login.py
PARAFORM_CACHE_PATH=./paraform_jobs_cache.json
PARAFORM_CACHE_TTL_MINUTES=30
PARAFORM_MAX_DETAIL_PAGES=0         # >0 fetches N job detail pages for richer descriptions

# Matching
MAX_JOBS_TO_LLM=60                  # deterministic prefilter cap before the Claude call
TOP_N_MATCHES=2
